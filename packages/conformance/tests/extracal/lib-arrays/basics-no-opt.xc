	DO (6000) NEXT
	DO (20) NEXT
	DO (6040) NEXT
	PLEASE .1 <- #9
	DO (6020) NEXT
	DO :1 <- #7
	DO (6050) NEXT
	PLEASE (21) NEXT
	DO GIVE UP
(20)	DO STASH .1 + .2 + .3 + :1
	DO .1 <- #1
	PLEASE (2110) NEXT
	DO .2 <- #10
	DO (2010) NEXT
	DO RETRIEVE .1 + .2 + .3 + :1
	PLEASE RESUME #1
(21)	DO STASH :1
	DO :1 <- .2
	DO (20) NEXT
	PLEASE RETRIEVE :1
	DO RESUME #1
