PLEASE NOTE THAT ;;1 IS AN ARRAY OF 64-BIT ELEMENTS
DO ;;1 <- #2 BY #2
DO ;;1 SUB #1 #2 <- ####12345678901234567890
DO ;;1 SUB #2 #1 <- ##4000000000
PLEASE READ OUT ;;1 SUB #1 #2 + ;;1 SUB #2 #1 + ;;1 SUB #2 #2
DO STASH ;;1
DO ;;1 <- #1
PLEASE ;;1 SUB #1 <- #7
DO READ OUT ;;1 SUB #1
DO RETRIEVE ;;1
DO READ OUT ;;1 SUB #1 #2
DO IGNORE ;;1
PLEASE ;;1 SUB #1 #2 <- #9
DO READ OUT ;;1 SUB #1 #2
DO ;;1 SUB #3 #1 <- #9
DO GIVE UP
