PLEASE NOTE THAT READ OUT SIGNED PRINTS A MINUS AND THE NUMERAL OF THE MAGNITUDE, AT EVERY WIDTH
DO READ OUT SIGNED #65535 + #32768 + #32767 + #5 + #0
DO :1 <- ##2147483648
DO ::1 <- ####18446744073709551615
PLEASE READ OUT SIGNED :1 + ##4294967295 + ::1
DO READ OUT SIGNED ####9223372036854775808 + ####9223372036854775807
DO .1 <- #65535
DO READ OUT .1
DO GIVE UP
