PLACET NOTE THAT EVERY STATEMENT HAS A LATIN NAME
FAC ,1 <- #2 MULTIPLICATUS A #3
FAC ,1 SUB #2 #3 <- #7
FAC LEGERE EX ,1 SUB #2 #3
FAC .1 <- #5
PLACET EXUERE .1
FAC .1 <- #6
FAC INUERE .1
FAC LEGERE EX .1
FAC DISSIMULARE .1
PLACET .1 <- #7
FAC MEMINISSE .1
FAC LEGERE EX .1
FAC (10) DEINDE
PLACET ABSTINERE FROM (11)
FAC (10) DEINDE
FAC REINSTARE (11)
FAC ABSTINERE FROM LEGENDUM
PLACET LEGERE EX #1
FAC REINSTARE LEGENDUM
FAC SCRIBERE IN .2
FAC LEGERE EX .2
PLACET ABSTINERE #2 FROM (12)
FAC CONCEDERE
(12) FAC LEGERE EX #9
FAC CONCEDERE
(10) FAC ALIENERE #0
(11) PLACET LEGERE EX #4
FAC RECOLERE #1
