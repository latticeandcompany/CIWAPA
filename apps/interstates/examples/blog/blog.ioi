DO ,1 SUB #26 <- #83
PLEASE ,1 SUB #27 <- #32
DO ,1 SUB #28 <- #112
DO ,1 SUB #29 <- #111
DO ,1 SUB #30 <- #115
PLEASE ,1 SUB #31 <- #116
DO ,1 SUB #32 <- #115
DO ,1 SUB #33 <- #32
DO ,1 SUB #34 <- #40
PLEASE ,1 SUB #35 <- #105
DO ,1 SUB #36 <- #100
DO ,1 SUB #37 <- #32
DO ,1 SUB #38 <- #73
PLEASE ,1 SUB #39 <- #78
DO ,1 SUB #40 <- #84
DO ,1 SUB #41 <- #69
DO ,1 SUB #42 <- #71
PLEASE ,1 SUB #43 <- #69
DO ,1 SUB #44 <- #82
DO ,1 SUB #45 <- #32
DO ,1 SUB #46 <- #80
PLEASE ,1 SUB #47 <- #82
DO ,1 SUB #48 <- #73
DO ,1 SUB #49 <- #77
DO ,1 SUB #50 <- #65
PLEASE ,1 SUB #51 <- #82
DO ,1 SUB #52 <- #89
DO ,1 SUB #53 <- #32
DO ,1 SUB #54 <- #75
PLEASE ,1 SUB #55 <- #69
DO ,1 SUB #56 <- #89
DO ,1 SUB #57 <- #44
DO ,1 SUB #58 <- #32
PLEASE ,1 SUB #59 <- #116
DO ,1 SUB #60 <- #105
DO ,1 SUB #61 <- #116
DO ,1 SUB #62 <- #108
PLEASE ,1 SUB #63 <- #101
DO ,1 SUB #64 <- #32
DO ,1 SUB #65 <- #84
DO ,1 SUB #66 <- #69
PLEASE ,1 SUB #67 <- #88
DO ,1 SUB #68 <- #84
DO ,1 SUB #69 <- #32
DO ,1 SUB #70 <- #78
PLEASE ,1 SUB #71 <- #79
DO ,1 SUB #72 <- #84
DO ,1 SUB #73 <- #32
DO ,1 SUB #74 <- #78
PLEASE ,1 SUB #75 <- #85
DO ,1 SUB #76 <- #76
DO ,1 SUB #77 <- #76
DO ,1 SUB #78 <- #44
PLEASE ,1 SUB #79 <- #32
DO ,1 SUB #80 <- #98
DO ,1 SUB #81 <- #111
DO ,1 SUB #82 <- #100
PLEASE ,1 SUB #83 <- #121
DO ,1 SUB #84 <- #32
DO ,1 SUB #85 <- #84
DO ,1 SUB #86 <- #69
PLEASE ,1 SUB #87 <- #88
DO ,1 SUB #88 <- #84
DO ,1 SUB #89 <- #32
DO ,1 SUB #90 <- #78
PLEASE ,1 SUB #91 <- #79
DO ,1 SUB #92 <- #84
DO ,1 SUB #93 <- #32
DO ,1 SUB #94 <- #78
PLEASE ,1 SUB #95 <- #85
DO ,1 SUB #96 <- #76
DO ,1 SUB #97 <- #76
DO ,1 SUB #98 <- #41
PLEASE :1 <- #0
DO :2 <- #1
DO (16200) NEXT
DO RESUME #1
