PLEASE COME FROM (16000) WITH ROUTE "/"
(10) DO READ OUT #1 WITH TEMPLATE "pages/home.html"
DO GIVE UP
DO COME FROM (10) WITH ROUTE "/secret"
PLEASE ,1 <- #6
DO ,1 SUB #1 <- #115
DO ,1 SUB #2 <- #101
DO ,1 SUB #3 <- #99
PLEASE ,1 SUB #4 <- #114
DO ,1 SUB #5 <- #101
DO ,1 SUB #6 <- #116
DO .1 <- #1
PLEASE (2310) NEXT
DO GIVE UP
DO COME FROM (10) WITH ROUTE "/post/:id"
DO ,1 <- ;4400 SUB #1
PLEASE .1 <- #1
DO (2310) NEXT
DO GIVE UP
DO COME FROM (16000) WITH ROUTE "/other"
DO GIVE UP
