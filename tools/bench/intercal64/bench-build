#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): bench-build <src.i> <out>
set -euo pipefail
src=$1 out=$2
bin=/opt/src/intercal64/bin

# churn emits a .NET app (apphost + dlls) into its working directory, so it
# lives in <out>.d and <out> is a wrapper that execs it.
rm -rf "$out.d"
mkdir -p "$out.d"
cp "$src" "$out.d/prog.i"
(cd "$out.d" && dotnet "$bin/churn.dll" -b "-r:$bin/syslib64.dll" prog.i) | tee "$out.d/churn.log"
rm -f "$out.d/prog.i"

# churn always exits 0: its errors (E079 politeness included) print to stdout and
# compilation carries on, so look for its error trailer and for the apphost.
if grep -q "CORRECT SOURCE AND RESUBMIT" "$out.d/churn.log" || [ ! -x "$out.d/prog" ]; then
  echo "bench-build: churn failed" >&2
  exit 1
fi
rm "$out.d/churn.log"

printf '#!/bin/sh\nexec "%s/prog" "$@"\n' "$(realpath "$out.d")" >"$out"
chmod +x "$out"
