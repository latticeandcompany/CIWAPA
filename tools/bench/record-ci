#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): records a CI run's benchmark results as the baseline the
# CI regression check compares against (the `ci` section of tools/bench/results.json).
# Usage: tools/bench/record-ci <GitHub Actions run id>
set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$repo_root"
rm -rf .cache/bench-ci
gh run download "$1" --pattern 'bench-*' --dir .cache/bench-ci
tools/in-docker sh -c 'dart --suppress-analytics run tools/bench/regression.dart --record tools/bench/results.json .cache/bench-ci/*/regression.jsonl'
rm -rf .cache/bench-ci
