#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): bench-build <src.i> <out>
set -euo pipefail
src=$1 out=$2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# -b: no E774 random bug. -o: rick's optimizer. -O: rustc -O.
# -F: don't fold input-free programs (beer.i) into one print at compile time,
#     which would leave nothing to time.
cp "$src" "$work/prog.i"
(cd "$work" && rick -b -o -O -F prog.i)
cp "$work/prog" "$out"
