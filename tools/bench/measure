#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): runs inside one implementation's container. Builds each
# benchmark with `<build> <src> <out>`, runs it, and prints one JSON line per program.
# With BENCH_KEEP=<dir>, the executables are also kept in <dir> (runs can be 0, to build only).
# With BENCH_PREBUILT=<dir>, nothing is built: the executables kept there are run instead, so
# native baselines can run in the same container as CIWAPA's programs.
# Usage: tools/bench/measure <impl> <runs> [build command...]
set -uo pipefail

impl="$1"
runs="$2"
shift 2
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
now() { date +%s%N; }
ms() { echo $(( ($2 - $1) / 1000000 )); }
us() { echo $(( ($2 - $1) / 1000 )); }

# hail_mary never stops, so it is timed until it has printed this much.
hail_mary_bytes=2000000

# What starting any process costs in this container, so images compare on the programs alone.
spawn_us=999999999
for ((i = 0; i < 20; i++)); do
  start="$(now)"
  (cd "$work" && /bin/true </dev/null >"$work/out")
  t="$(us "$start" "$(now)")"
  ((t < spawn_us)) && spawn_us="$t"
done

grep -v '^#' tools/bench/programs.txt | while IFS='|' read -r name src input impls blocked; do
  name="$(echo $name)" src="$(echo $src)" input="$(echo $input)" impls="$(echo $impls)" blocked="$(echo $blocked)"
  [[ -n "$name" ]] || continue
  [[ "$impls" == all || ",$impls," == *",$impl,"* ]] || continue
  [[ -n "$blocked" ]] && continue
  if [[ -n "$input" ]]; then input="$PWD/$input"; else input=/dev/null; fi
  ext="${src##*.}"
  if [[ -n "${BENCH_PREBUILT:-}" ]]; then
    [[ -x "$BENCH_PREBUILT/$name" ]] || continue
    cp "$BENCH_PREBUILT/$name" "$work/$name"
    build_ms=null
  else
    cp "$src" "$work/$name.$ext"
    # The fastest of three builds, as for the empty dart compile exe it's compared with.
    build_ms=999999999
    for ((b = 0; b < 3; b++)); do
      start="$(now)"
      if ! (cd "$work" && timeout 600 "$@" "$name.$ext" "$work/$name" >"$work/build.log" 2>&1); then
        build_ms=failed
        break
      fi
      t="$(ms "$start" "$(now)")"
      ((t < build_ms)) && build_ms="$t"
    done
    if [[ "$build_ms" == failed ]]; then
      printf '{"impl":"%s","program":"%s","error":"build failed: %s"}\n' "$impl" "$name" \
        "$(head -c 200 "$work/build.log" | tr -d '"\\' | tr '\n\t' '  ')"
      continue
    fi
    if [[ -n "${BENCH_KEEP:-}" ]]; then
      mkdir -p "$BENCH_KEEP"
      cp "$work/$name" "$BENCH_KEEP/$name"
    fi
  fi
  if ((runs == 0)); then
    printf '{"impl":"%s","program":"%s","build_ms":%s}\n' "$impl" "$name" "$build_ms"
    continue
  fi
  # Quick programs are dominated by noise, so they run until a second is spent (up to 200 runs);
  # the summary takes the fastest run.
  times=()
  spent=0
  for ((i = 0; i < runs || (spent < 1000000 && i < 200); i++)); do
    start="$(now)"
    if [[ "$name" == hail_mary ]]; then
      (cd "$work" && timeout 600 "./$name" <"$input" 2>/dev/null | head -c "$hail_mary_bytes" >"$work/out")
      status=0
    else
      (cd "$work" && timeout 600 "./$name" <"$input" >"$work/out" 2>/dev/null)
      status=$?
    fi
    t="$(us "$start" "$(now)")"
    times+=("$t")
    spent=$((spent + t))
  done
  sha="$(sha256sum "$work/out" | cut -c1-16)"
  printf '{"impl":"%s","program":"%s","build_ms":%s,"run_us":[%s],"exit":%s,"stdout":"%s","spawn_us":%s}\n' \
    "$impl" "$name" "$build_ms" "$(IFS=,; echo "${times[*]}")" "$status" "$sha" "$spawn_us"
done
