#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): writes .cache/bench/programs/{primes,pi,fft,life}.i, the
# pit programs that call C-INTERCAL's internal library labels, with 0.35's own syslib.i appended so
# every compiler runs the same code (decision L10), and floatlib.i too for fft (decision L11).
# fetch-pit checks the tarball's hash first. The libraries go straight from the tarball into the
# programs: nothing reads them, nothing commits them.
set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$repo_root"
tools/oracle/fetch-pit >/dev/null
mkdir -p .cache/bench/programs
for program in primes pi fft life; do
  cat "pit/$program.i" >".cache/bench/programs/$program.i"
  tar -xzf .cache/intercal-0.35.tar.gz -O intercal-0.35/pit/lib/syslib.i >>".cache/bench/programs/$program.i"
done
tar -xzf .cache/intercal-0.35.tar.gz -O intercal-0.35/pit/lib/floatlib.i >>.cache/bench/programs/fft.i
