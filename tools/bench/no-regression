#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): Q111's check that Mode 1 got no slower during goal 2.
# Measures both CIWAPA flavors on the benchmark set exactly as tools/bench/bench does, and compares
# each program's fastest run with goal 1's, recorded before goal 2 changed anything. The verdict
# goes to tools/goal/no-regression.json, which goal-status reads after tools/bench is gone.
# Usage: tools/bench/no-regression [--record] [runs per program, default 5]
#   --record measures goal 1's timings into tools/goal/goal1-baseline.json instead.
set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$repo_root"
mode=--compare
if [[ "${1:-}" == --record ]]; then
  mode=--record
  shift
fi
CIWAPA_ONLY=1 tools/bench/bench "${1:-5}"
tools/in-docker dart --suppress-analytics run tools/bench/no_regression.dart "$mode" \
  .cache/bench/runs.jsonl tools/goal/goal1-baseline.json tools/goal/no-regression.json
