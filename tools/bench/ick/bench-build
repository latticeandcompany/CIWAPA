#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): bench-build <src.i> <out>
set -euo pipefail
src=$1 out=$2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# ick writes next to its input and takes the base (.i, .3i, ...) from the extension.
name=$(basename "$src")
cp "$src" "$work/$name"
(cd "$work" && ick -b -O "$name")
cp "$work/${name%.*}" "$out"
