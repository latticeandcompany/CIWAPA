#!/usr/bin/env bash
# TEMPORARY (goal 2's cleanup removes it): runs programs through C-INTERCAL (0.35 and 0.15) and
# both CIWAPA flavors, and records each one's stdout and exit (Q36, Q98). An exit is the status, plus
# the ICL code of a run-time error ("0:ICL000"), or "compile:ICLnnn". The rest of stderr isn't
# compared: CIWAPA's messages and statement numbering differ on purpose (Q83, T33).
#
# Usage: tools/oracle/differential [conformance|pit|all|extracal]
# Leaves <name>.out.<impl> and <name>.exit.<impl> in .cache/oracle/programs for
# tools/oracle/triage.dart, and lists the programs whose results differ in .cache/oracle/differences.txt.
# extracal compiles every pit/ program as EXTRACAL (.xc, or .3xc-.7xc) and runs it against 0.35 only;
# `triage.dart extracal` then writes goal 2's verdict, tools/goal/oracle.json.
set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$repo_root"
what="${1:-all}"
case "$what" in conformance | pit | all | extracal) ;; *) echo "unknown mode: $what" >&2; exit 2 ;; esac
work="$repo_root/.cache/oracle"
rm -rf "$work"
mkdir -p "$work/programs"

# Copy the programs into one directory that every container can see; ick wants ASCII mingle.
list="$work/programs.txt"
: >"$list"
add() { # name source-file input-file-or-empty [ick options]
  if [[ "$what" == extracal ]]; then
    set -- "$(sed -E 's/\.([2-7]?)i$/.\1xc/' <<<"$1")" "$2" "$3" "${4:-}"
  fi
  LC_ALL=C sed 's/¢/$/g' "$2" >"$work/programs/$1"
  [[ -n "$3" && -f "$3" ]] && cp "$3" "$work/programs/$1.in"
  [[ "$what" == extracal && -n "${4:-}" ]] && echo "$4" >"$work/programs/$1.ickflags"
  echo "$1" >>"$list"
}
if [[ "$what" == conformance || "$what" == all ]]; then
  while IFS= read -r f; do
    stem="${f%.*}"
    [[ -f "$stem.flags" || -f "$stem.args" || -f "$stem.timeout" || -f "$stem.env" ]] && continue
    add "$(echo "${f#"$repo_root/"}" | tr '/' '_')" "$f" "$stem.in"
  done < <(find "$repo_root/packages/conformance/tests" -type f \( -name '*.i' -o -name '*.[2-7]i' \) | sort)
fi
if [[ "$what" != conformance ]]; then
  [[ -d "$repo_root/pit" ]] || "$repo_root/tools/oracle/fetch-pit" >/dev/null
  # Programs pit/'s Makefile runs with particular input; every other one gets <stem>.tst, if any.
  special="$(grep -v '^#' "$repo_root/tools/oracle/pit-inputs" | cut -d'|' -f2 | tr -d ' ')"
  while IFS='|' read -r name source input; do
    name="$(echo $name)" source="$(echo $source)" input="$(echo $input)"
    [[ -n "$name" && "$name" != \#* ]] || continue
    if [[ "$input" == text:* ]]; then
      printf '%s\n' "${input#text:}" >"$work/$name.input"
      input="$work/$name.input"
    elif [[ -n "$input" ]]; then
      input="$repo_root/pit/$input"
    fi
    add "pit_$name" "$repo_root/pit/$source" "$input"
  done <"$repo_root/tools/oracle/pit-inputs"
  while IFS= read -r f; do
    rel="${f#"$repo_root/pit/"}"
    grep -qx "$rel" <<<"$special" && continue
    stem="${f%.*}"
    flags="$(grep -v '^#' "$repo_root/tools/oracle/pit-flags" | awk -F' *[|] *' -v p="$rel" '$1 == p {print $2}')"
    add "pit_$(echo "$rel" | tr '/' '_')" "$f" "$stem.tst" "$flags"
  done < <(find "$repo_root/pit" -path "$repo_root/pit/lib" -prune -o -type f \( -name '*.i' -o -name '*.[3-7]i' \) -print | sort)
fi
cp "$list" "$work/programs/list"

# Runs inside each container, from the programs directory. Output goes to the container's own /tmp
# first: through a bind mount, output flushed at every newline (T31) is slow enough to time out.
# Usage: run <impl> <build command prefix>; the build command gets "<source> -o /tmp/b/p" appended
# for CIWAPA, or is "ick-build" for ick.
run_all='
impl="$1"
shift
for f in $(cat list); do
  ext="${f##*.}"
  case "$impl" in ick*) ext="$(echo "$ext" | sed "s/xc$/i/")" ;; esac
  rm -rf /tmp/b && mkdir -p /tmp/b && cp "$f" "/tmp/b/p.$ext"
  case "$impl" in ick*) [ -f "$f.ickflags" ] && cp "$f.ickflags" /tmp/b/ickflags ;; esac
  if (cd /tmp/b && "$@" "p.$ext" >/tmp/b/cerr 2>&1); then
    input=/dev/null
    [ -f "$f.in" ] && input="$f.in"
    timeout 10 /tmp/b/p <"$input" >/tmp/b/out 2>/tmp/b/err
    status=$?
    code="$(grep -ao "ICL[0-9][0-9][0-9]" /tmp/b/err | head -n 1)"
    cp /tmp/b/out "$f.out.$impl"
    echo "$status${code:+:$code}" >"$f.exit.$impl"
  else
    : >"$f.out.$impl"
    echo "compile:$(grep -ao "ICL[0-9][0-9][0-9]" /tmp/b/cerr | head -n 1)" >"$f.exit.$impl"
  fi
done
rm -rf /tmp/b'

oracles="0.35:ick035 0.15:ick015"
[[ "$what" == extracal ]] && oracles="0.35:ick035"
for oracle in $oracles; do
  docker run --rm --user "$(id -u):$(id -g)" -v "$work/programs:/work" -w /work \
    "ciwapa-oracle-ick:${oracle%%:*}" sh -c "$run_all" sh "${oracle#*:}" sh -c 'timeout 60 ick -b $(cat ickflags 2>/dev/null) "$0"'
done

# The verdict names the commit the compilers come from; it is dirty if packages/ has uncommitted
# changes, or changes while the flavors run.
sha="$(git rev-parse HEAD)"
packages="$(git status --porcelain -- packages/)"
# Fresh compilers of their own, so a concurrent CI check rebuilding .cache/build can't interfere.
"$repo_root/tools/in-docker" sh -c 'for flavor in llvm dart; do
  dart --suppress-analytics compile exe "packages/ciwapa_$flavor/bin/ciwapa_$flavor.dart" -o ".cache/oracle/ciwapa-$flavor" >/dev/null
done'
for flavor in llvm dart; do
  "$repo_root/tools/in-docker" sh -c "cd /work/.cache/oracle/programs && $run_all" sh "$flavor" \
    sh -c '/work/.cache/oracle/ciwapa-'"$flavor"' build --no-random-bug "$0" -o p'
done

dirty=false
if [[ -n "$packages" || "$(git rev-parse HEAD)" != "$sha" ||
  "$(git status --porcelain -- packages/)" != "$packages" ]]; then
  dirty=true
fi
echo "$sha" >"$work/programs/sha"
echo "$dirty" >"$work/programs/dirty"

while IFS= read -r f; do
  for impl in $(for o in $oracles; do echo "${o#*:}"; done); do
    for flavor in llvm dart; do
      if ! cmp -s "$work/programs/$f.out.$impl" "$work/programs/$f.out.$flavor" ||
        ! cmp -s "$work/programs/$f.exit.$impl" "$work/programs/$f.exit.$flavor"; then
        echo "$impl $flavor $f: ick $(cat "$work/programs/$f.exit.$impl"), ours $(cat "$work/programs/$f.exit.$flavor")"
      fi
    done
  done
done <"$list" >"$work/differences.txt"
echo "$(wc -l <"$work/differences.txt" | tr -d ' ') differences across $(wc -l <"$list" | tr -d ' ') programs: $work/differences.txt"
