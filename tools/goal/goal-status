#!/usr/bin/env bash
# TEMPORARY (removed last, by goal 2's cleanup): reports goal 2's acceptance criteria.
# GitHub state is collected here on the host with gh; tools/goal/goal_status.dart judges it.
set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cache="$repo_root/.cache/goal"
rm -rf "$cache"
mkdir -p "$cache/artifacts"

git -C "$repo_root" fetch --quiet origin mega
sha="$(git -C "$repo_root" rev-parse origin/mega)"
echo "$sha" >"$cache/mega-sha"
git -C "$repo_root" rev-parse HEAD >"$cache/head-sha"
git -C "$repo_root" ls-files tools/oracle tools/bench >"$cache/tracked-scaffolding"
docker image ls --format '{{.Repository}}:{{.Tag}}' >"$cache/docker-images"
echo "ciwapa-toolchain:$(shasum -a 256 "$repo_root/Dockerfile" | cut -c1-12)" >"$cache/toolchain-image"

# A verdict counts only if the compiler hasn't changed since the commit it measured.
for verdict in no-regression oracle; do
  file="$repo_root/tools/goal/$verdict.json"
  [[ -f "$file" ]] || continue
  measured="$(jq -r '.sha // empty' "$file")"
  if [[ -n "$measured" && "$(jq -r '.dirty' "$file")" == false ]] &&
    git -C "$repo_root" diff --quiet "$measured" "$sha" -- packages/ 2>/dev/null; then
    echo current >"$cache/$verdict-freshness"
  else
    echo "stale: measured at ${measured:-an unknown commit}${measured:+ (or with uncommitted changes)}, and packages/ changed since" >"$cache/$verdict-freshness"
  fi
done

gh run list --commit "$sha" --limit 100 \
  --json databaseId,workflowName,status,conclusion,event,headBranch >"$cache/runs.json"

for workflow in "CI" "Release archives"; do
  id="$(jq -r --arg w "$workflow" \
    '[.[] | select(.workflowName == $w and .event == "push" and .headBranch == "mega")][0].databaseId // empty' \
    "$cache/runs.json")"
  [[ -n "$id" ]] || continue
  slug="$(tr ' A-Z' '-a-z' <<<"$workflow")"
  gh run view "$id" --json jobs,status,conclusion >"$cache/run-$slug.json"
  gh api "repos/{owner}/{repo}/actions/runs/$id/artifacts" --paginate \
    --jq '.artifacts[] | {name, expired}' | jq -s . >"$cache/artifacts-$slug.json"
  if [[ "$workflow" == "CI" ]]; then
    gh run download "$id" --pattern 'conformance-*' --dir "$cache/artifacts" 2>/dev/null || true
  fi
done

exec "$repo_root/tools/in-docker" dart run tools/goal/goal_status.dart
