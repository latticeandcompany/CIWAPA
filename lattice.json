{
  "$schema": ".lattice/schema.json",
  "latticeVersion": "1.1.1",
  "tasks": {
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "lint": {},
    "format": {},
    "build": {}
  },
  "workspaces": [
    {
      "name": "ciwapa",
      "path": ".",
      "auto": false,
      "scripts": {
        "lint": "tools/in-docker dart analyze --fatal-infos",
        "format": "tools/in-docker dart format --output=none --set-exit-if-changed .",
        "test": "",
        "build": ""
      }
    },
    {
      "name": "ciwapa_core",
      "path": "packages/ciwapa_core",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      }
    },
    {
      "name": "ciwapa_lsp",
      "path": "packages/ciwapa_lsp",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      },
      "dependsOn": [
        "ciwapa_core"
      ]
    },
    {
      "name": "ciwapa_dart",
      "path": "packages/ciwapa_dart",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      },
      "dependsOn": [
        "ciwapa_core",
        "ciwapa_lsp"
      ]
    },
    {
      "name": "ciwapa_llvm",
      "path": "packages/ciwapa_llvm",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      },
      "dependsOn": [
        "ciwapa_core",
        "runtime_c",
        "ciwapa_lsp"
      ]
    },
    {
      "name": "runtime_c",
      "path": "packages/runtime_c",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      }
    },
    {
      "name": "conformance",
      "path": "packages/conformance",
      "auto": false,
      "scripts": {
        "test": "",
        "lint": "",
        "format": "",
        "build": ""
      }
    },
    {
      "name": "interstates",
      "path": "apps/interstates",
      "auto": false,
      "scripts": {
        "test": "../../tools/in-docker dart --suppress-analytics test",
        "lint": "",
        "format": "",
        "build": ""
      },
      "dependsOn": [
        "ciwapa_core",
        "ciwapa_dart",
        "ciwapa_llvm",
        "ciwapa_lsp"
      ]
    },
    {
      "name": "vscode",
      "path": "editors/vscode",
      "auto": false,
      "scripts": {
        "lint": "../../tools/in-docker --image node sh -c 'npm ci --no-audit --no-fund && npm run lint'",
        "test": "mkdir -p ../../.cache/build && ../../tools/in-docker dart --suppress-analytics compile exe ../../packages/ciwapa_llvm/bin/ciwapa_llvm.dart -o ../../.cache/build/ciwapa-llvm && ../../tools/in-docker --image node sh -c 'npm ci --no-audit --no-fund && npm test && xvfb-run -a npm run smoke'",
        "build": "../../tools/in-docker --image node sh -c 'npm ci --no-audit --no-fund && npm run build'",
        "format": ""
      },
      "dependsOn": [
        "ciwapa_llvm"
      ]
    },
    {
      "name": "jetbrains",
      "path": "editors/jetbrains",
      "auto": false,
      "scripts": {
        "lint": "../../tools/in-docker --image jdk ./gradlew --console=plain lint",
        "test": "mkdir -p ../../.cache/build && ../../tools/in-docker dart --suppress-analytics compile exe ../../packages/ciwapa_llvm/bin/ciwapa_llvm.dart -o ../../.cache/build/ciwapa-llvm && ../../tools/in-docker --image jdk ./gradlew --console=plain test",
        "build": "../../tools/in-docker --image jdk ./gradlew --console=plain buildPlugin",
        "format": ""
      },
      "dependsOn": [
        "ciwapa_llvm"
      ]
    },
    {
      "name": "neovim",
      "path": "editors/neovim",
      "auto": false,
      "scripts": {
        "lint": "../../tools/in-docker --image neovim test/run lint",
        "test": "mkdir -p ../../.cache/build && ../../tools/in-docker dart --suppress-analytics compile exe ../../packages/ciwapa_llvm/bin/ciwapa_llvm.dart -o ../../.cache/build/ciwapa-llvm && ../../tools/in-docker --image neovim test/run unit && ../../tools/in-docker --image neovim test/run smoke",
        "build": "",
        "format": ""
      },
      "dependsOn": [
        "ciwapa_llvm"
      ]
    }
  ],
  "globalDependencies": [
    "Dockerfile",
    "tools/docker/jdk.Dockerfile",
    "tools/docker/neovim.Dockerfile",
    "tools/docker/node.Dockerfile",
    "tools/in-docker",
    "pubspec.lock"
  ]
}
